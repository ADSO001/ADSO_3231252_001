doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title SIGCMI - Verificación de Médicos
    script(src="https://cdn.tailwindcss.com")
    //- Lucide Icons (CDN)
    script(src="https://unpkg.com/lucide@latest")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    div(class="flex flex-col md:flex-row min-h-screen")
      
      //- BARRA LATERAL (SIDEBAR - Exacta al Panel Principal)
      aside(class="w-full md:w-[260px] bg-white border-r border-gray-200 flex flex-col shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto")
        div(class="p-[20px] flex items-center gap-[10px] border-b border-gray-200")
          div(class="w-[60px] h-[60px] max-w-[60px] max-h-[60px]")
            img(src="img/logo.png", alt="logo", class="w-full h-full object-contain")
          h1(class="text-[20px] font-bold") SIGCMI

        nav(class="flex-1 p-[20px_10px] flex flex-col gap-[8px]")
          a(href="/adminPanel", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="layout-dashboard", class="w-[20px] h-[20px]")
            | Panel principal

          a(href="/appointmentScheduleAdmin", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="calendar", class="w-[20px] h-[20px]")
            | Agenda de citas

          a(href="/patientManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="users", class="w-[20px] h-[20px]")
            | Pacientes

          a(href="", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="stethoscope", class="w-[20px] h-[20px]")
            | Médicos

          a(href="/managementSpecialities", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#000000] rounded-[10px] text-[14px] font-bold bg-[#e0e0e0] no-underline")
            i(data-lucide="user-check", class="w-[20px] h-[20px]")
            | Verificar Médicos

          a(href="/doctorsHours", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="clock", class="w-[20px] h-[20px]")
            | Horarios

        div(class="p-[20px] border-t border-gray-200 flex flex-col gap-[15px]")
          div(class="flex items-center gap-[10px]")
            div(class="w-[35px] h-[35px] rounded-full bg-black text-white flex items-center justify-center")
              i(data-lucide="user", class="w-[20px] h-[20px]")
            div(class="flex flex-col")
              span(class="text-[14px] font-bold text-gray-900") Admin
              span(class="text-[12px] text-gray-500") Administrador

          a(href="/login", class="no-underline")
            button(type="button", class="bg-black text-white px-[15px] py-[10px] rounded-[20px] flex items-center justify-center gap-[10px] font-bold text-[14px] w-fit cursor-pointer hover:opacity-80 transition-opacity border-none")
              i(data-lucide="log-out", class="w-[18px] h-[18px]")
              | Cerrar sesión

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 p-[30px] bg-[#fafafa]")
        
        //- ENCABEZADO
        header(class="mb-[30px]")
          h2(class="text-[24px] font-bold mb-[5px] text-gray-900") Verificación de Médicos
          p(class="text-[14px] text-gray-500 m-0") Revisa y aprueba las solicitudes de registro de médicos

        //- TARJETAS DE RESUMEN / ESTADÍSTICAS
        section(class="grid grid-cols-1 sm:grid-cols-3 gap-[20px] mb-[30px]")
          
          //- Pendientes
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] flex flex-col justify-between h-[130px]")
            div(class="flex justify-between items-start")
              span(class="text-[14px] font-bold text-gray-800") Pendientes
              i(data-lucide="clock", class="w-[20px] h-[20px] text-gray-700")
            div
              div(class="text-[28px] font-bold text-gray-900 leading-none mb-[5px]") 2
              span(class="text-[13px] text-gray-400 font-medium") Solicitudes por revisar

          //- Verificados
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] flex flex-col justify-between h-[130px]")
            div(class="flex justify-between items-start")
              span(class="text-[14px] font-bold text-gray-800") Verificados
              i(data-lucide="check-circle-2", class="w-[20px] h-[20px] text-gray-700")
            div
              div(class="text-[28px] font-bold text-gray-900 leading-none mb-[5px]") 1
              span(class="text-[13px] text-gray-400 font-medium") Médicos aprobados

          //- Rechazados
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] flex flex-col justify-between h-[130px]")
            div(class="flex justify-between items-start")
              span(class="text-[14px] font-bold text-gray-800") Rechazados
              i(data-lucide="x-circle", class="w-[20px] h-[20px] text-gray-700")
            div
              div(class="text-[28px] font-bold text-gray-900 leading-none mb-[5px]") 0
              span(class="text-[13px] text-gray-400 font-medium") Solicitudes rechazadas

        //- LISTA DE SOLICITUDES DE VERIFICACIÓN
        section
          div(class="mb-[20px]")
            h3(class="text-[16px] font-bold text-gray-900 m-0 mb-[3px]") Solicitudes de Verificación
            p(class="text-[13px] text-gray-400 m-0") Revisa la documentación y aprueba o rechaza las solicitudes

          div(class="flex flex-col gap-[20px]")
            
            //- Tarjeta 1: Dr. Carlos Rodríguez
            div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm")
              div(class="flex flex-col md:flex-row md:items-start justify-between gap-[15px] mb-[15px]")
                div(class="flex items-center gap-[10px]")
                  h4(class="text-[16px] font-bold text-gray-900 m-0") Dr. Carlos Rodríguez
                  span(class="inline-flex items-center gap-[4px] px-[10px] py-[2px] rounded-[12px] text-[11px] font-semibold bg-gray-200 text-gray-700")
                    i(data-lucide="clock", class="w-[12px] h-[12px]")
                    | Pendiente

                //- Botones de acción
                div(class="flex items-center gap-[10px] self-start md:self-auto")
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="check-circle-2", class="w-[14px] h-[14px]")
                    | Aprobar
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="x-circle", class="w-[14px] h-[14px]")
                    | Rechazar

              p(class="text-[14px] text-gray-500 m-0 mb-[15px]") Cardiología

              div(class="grid grid-cols-1 md:grid-cols-2 gap-y-[6px] gap-x-[20px] text-[13px] mb-[20px]")
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Email:
                  a(href="mailto:juan.perez@email.com", class="text-gray-600 underline hover:text-black") juan.perez@email.com
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Teléfono:
                  span(class="text-gray-600") ++57 300 3213443
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Licencia:
                  span(class="text-gray-800 font-bold") 1234
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Cédula:
                  span(class="text-gray-600") CP-789012
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Experiencia:
                  span(class="text-gray-800 font-bold") 8 años
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Aplicado:
                  span(class="text-gray-600") 28/2/2026

              a(href="#", class="inline-flex items-center gap-[8px] text-[13px] text-gray-500 hover:text-black no-underline font-medium")
                i(data-lucide="folder", class="w-[16px] h-[16px]")
                | Ver documento de verificación

            //- Tarjeta 2: Dr. Ana Martínez
            div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm")
              div(class="flex flex-col md:flex-row md:items-start justify-between gap-[15px] mb-[15px]")
                div(class="flex items-center gap-[10px]")
                  h4(class="text-[16px] font-bold text-gray-900 m-0") Dr. Ana Martínez
                  span(class="inline-flex items-center gap-[4px] px-[10px] py-[2px] rounded-[12px] text-[11px] font-semibold bg-gray-200 text-gray-700")
                    i(data-lucide="clock", class="w-[12px] h-[12px]")
                    | Pendiente

                //- Botones de acción
                div(class="flex items-center gap-[10px] self-start md:self-auto")
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="check-circle-2", class="w-[14px] h-[14px]")
                    | Aprobar
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="x-circle", class="w-[14px] h-[14px]")
                    | Rechazar

              p(class="text-[14px] text-gray-500 m-0 mb-[15px]") Pediatría

              div(class="grid grid-cols-1 md:grid-cols-2 gap-y-[6px] gap-x-[20px] text-[13px] mb-[20px]")
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Email:
                  a(href="mailto:ana.martinez@email.com", class="text-gray-600 underline hover:text-black") ana.martinez@email.com
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Teléfono:
                  span(class="text-gray-600") ++57 300 3213443
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Licencia:
                  span(class="text-gray-800 font-bold") 4321
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Cédula:
                  span(class="text-gray-600") CP-789012
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Experiencia:
                  span(class="text-gray-800 font-bold") 5 años
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Aplicado:
                  span(class="text-gray-600") 28/2/2026

              a(href="#", class="inline-flex items-center gap-[8px] text-[13px] text-gray-500 hover:text-black no-underline font-medium")
                i(data-lucide="folder", class="w-[16px] h-[16px]")
                | Ver documento de verificación

            //- Tarjeta 3: Dr. Luis González
            div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm")
              div(class="flex flex-col md:flex-row md:items-start justify-between gap-[15px] mb-[15px]")
                div(class="flex items-center gap-[10px]")
                  h4(class="text-[16px] font-bold text-gray-900 m-0") Dr. Luis González
                  span(class="inline-flex items-center gap-[4px] px-[10px] py-[2px] rounded-[12px] text-[11px] font-bold bg-black text-white")
                    i(data-lucide="user-check", class="w-[12px] h-[12px]")
                    | Verificado

                //- Botones de acción
                div(class="flex items-center gap-[10px] self-start md:self-auto")
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="check-circle-2", class="w-[14px] h-[14px]")
                    | Aprobar
                  button(type="button", class="flex items-center gap-[5px] px-[14px] py-[6px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm")
                    i(data-lucide="x-circle", class="w-[14px] h-[14px]")
                    | Rechazar

              p(class="text-[14px] text-gray-500 m-0 mb-[15px]") Dermatología

              div(class="grid grid-cols-1 md:grid-cols-2 gap-y-[6px] gap-x-[20px] text-[13px] mb-[20px]")
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Email:
                  a(href="mailto:luis.gonzalez@email.com", class="text-gray-600 underline hover:text-black") luis.gonzalez@email.com
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Teléfono:
                  span(class="text-gray-600") ++57 300 3213443
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Licencia:
                  span(class="text-gray-800 font-bold") 9876
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Cédula:
                  span(class="text-gray-600") CP-789012
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Experiencia:
                  span(class="text-gray-800 font-bold") 12 años
                div(class="flex items-center gap-[5px]")
                  span(class="text-gray-400 font-medium") Aplicado:
                  span(class="text-gray-600") 28/2/2026

              a(href="#", class="inline-flex items-center gap-[8px] text-[13px] text-gray-500 hover:text-black no-underline font-medium")
                i(data-lucide="folder", class="w-[16px] h-[16px]")
                | Ver documento de verificación

    //- Script para inicializar los íconos de Lucide
    script.
      lucide.createIcons();