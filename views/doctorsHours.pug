      main(class="flex-1 p-[30px] bg-[#fafafa]")
        
        //- ENCABEZADO
        header(class="mb-[25px]")
          h2(class="text-[22px] font-bold mb-[5px] text-gray-900") Horarios y Disponibilidad
          p(class="text-[14px] text-gray-500 m-0") Visualiza y gestiona los horarios de atención de los médicos

        //- TARJETA PRINCIPAL DEL CALENDARIO
        section(class="bg-white rounded-[16px] p-[20px] border border-gray-200 shadow-sm")
          
