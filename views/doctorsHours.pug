doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Horarios y Disponibilidad - SIGCMI
    link(rel="stylesheet" href="/css/output.css")
    script(src="https://unpkg.com/lucide@latest")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    div(class="flex flex-col md:flex-row min-h-screen")
      
      //- BARRA LATERAL (SIDEBAR)
      aside(class="w-full md:w-[260px] bg-white border-r border-gray-200 flex flex-col shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto")
        div(class="p-[20px] flex items-center gap-[10px] border-b border-gray-200")
          div(class="w-[60px] h-[60px] max-w-[60px] max-h-[60px]")
            img(src="img/logo.png", alt="logo", class="w-full h-full object-contain")
          h1(class="text-[20px] font-bold m-0") SIGCMI
        nav(class="flex-1 p-[20px_10px] flex flex-col gap-[8px]")
          a(href="/adminPanel", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="layout-dashboard", class="w-[20px] h-[20px]")
            | Panel principal
          a(href="/appointmentScheduleAdmin", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="calendar", class="w-[20px] h-[20px]")
            | Agenda de citas
          a(href="/patientManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="users", class="w-[20px] h-[20px]")
            | Pacientes
          a(href="/physicianManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="stethoscope", class="w-[20px] h-[20px]")
            | Médicos
          a(href="/managementSpecialities", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="user-check", class="w-[20px] h-[20px]")
            | Verificar Médicos
          a(href="/doctorsHours", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#000000] rounded-[10px] text-[14px] font-bold bg-[#e0e0e0] no-underline")
            i(data-lucide="clock", class="w-[20px] h-[20px]")
            | Horarios
        div(class="p-[20px] border-t border-gray-200 flex flex-col gap-[15px]")
          div(class="flex items-center gap-[10px]")
            div(class="w-[35px] h-[35px] rounded-full bg-black text-white flex items-center justify-center")
              i(data-lucide="user", class="w-[20px] h-[20px]")
            div(class="flex flex-col")
              span(class="text-[14px] font-bold text-gray-900") Admin
              span(class="text-[12px] text-gray-500") Administrador
          a(href="/login", class="no-underline")
            button(type="button", class="bg-black text-white px-[15px] py-[10px] rounded-[20px] flex items-center justify-center gap-[10px] font-bold text-[14px] w-fit cursor-pointer hover:opacity-80 transition-opacity border-none")
              i(data-lucide="log-out", class="w-[18px] h-[18px]")
              | Cerrar sesión

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 p-[30px] bg-[#fafafa]")
        header(class="mb-[25px]")
          h2(class="text-[22px] font-bold mb-[5px] text-gray-900") Horarios y Disponibilidad
          p(class="text-[14px] text-gray-500 m-0") Visualiza y gestiona los horarios de atención de los médicos

        //- FILTRO DE MÉDICOS
        div(class="mb-[20px] bg-white p-[20px] rounded-[12px] border border-gray-200 shadow-sm")
          form(action="/doctorsHours" method="GET" class="flex flex-col md:flex-row gap-[15px] items-end")
            div(class="w-full md:w-1/2")
              label(for="medicoId" class="block text-[13px] font-bold text-gray-700 mb-[5px]") Seleccione un Médico:
              select#medicoId(name="medicoId" class="w-full p-[10px] border border-gray-300 rounded-[8px] outline-none")
                option(value="") -- Elegir Médico --
                if medicos
                  each med in medicos
                    option(value=med.id selected=(medicoSeleccionado && medicoSeleccionado.id == med.id))= `Dr. ${med.nombre} ${med.apellido} - ${med.especialidad}`
            div
              button(type="submit" class="bg-black text-white px-[20px] py-[10px] rounded-[8px] font-bold hover:opacity-80 transition-opacity cursor-pointer") Ver Horario

        //- TARJETA PRINCIPAL DEL CALENDARIO
        if medicoSeleccionado
          
          //- BARRA DE NAVEGACIÓN DE SEMANAS
          div(class="flex flex-col md:flex-row justify-between items-center mb-[15px] bg-white p-[10px_20px] rounded-[12px] border border-gray-200 shadow-sm gap-[10px]")
            a(href=`/doctorsHours?medicoId=${medicoSeleccionado.id}&fecha=${fechaAnterior}` class="text-[13px] font-bold text-gray-600 hover:text-black bg-gray-100 px-[15px] py-[8px] rounded-[8px] shadow-sm no-underline") &larr; Semana anterior
            span(class="text-[15px] font-bold text-gray-800") Semana del #{diasSemana[0].texto} al #{diasSemana[6].texto}
            a(href=`/doctorsHours?medicoId=${medicoSeleccionado.id}&fecha=${fechaSiguiente}` class="text-[13px] font-bold text-gray-600 hover:text-black bg-gray-100 px-[15px] py-[8px] rounded-[8px] shadow-sm no-underline") Semana siguiente &rarr;

          section(class="bg-white rounded-[16px] p-[20px] border border-gray-200 shadow-sm")
            div(class="flex flex-col md:flex-row md:items-center justify-between gap-[15px] mb-[20px] pb-[15px] border-b border-gray-100")
              div(class="flex items-center gap-[10px]")
                div(class="w-[36px] h-[36px] rounded-full bg-gray-100 flex items-center justify-center text-gray-700")
                  i(data-lucide="calendar-check", class="w-[20px] h-[20px]")
                span(class="text-[14px] text-gray-500 font-semibold") Horarios
                span(class="text-[14px] text-gray-400") -
                h3(class="text-[18px] font-bold text-gray-900 m-0")= `Dr. ${medicoSeleccionado.nombre} ${medicoSeleccionado.apellido}`

              div(class="flex flex-wrap items-center gap-[20px] text-[13px] font-medium text-gray-600")
                div(class="flex items-center gap-[8px]")
                  span(class="w-[14px] h-[14px] rounded-md bg-emerald-100 border border-emerald-400 inline-block")
                  | Disponible
                div(class="flex items-center gap-[8px]")
                  span(class="w-[14px] h-[14px] rounded-md bg-amber-100 border border-amber-400 inline-block")
                  | Ocupado
                div(class="flex items-center gap-[8px]")
                  span(class="w-[14px] h-[14px] rounded-md bg-gray-100 border border-gray-300 inline-block")
                  | Fines de semana

            div(class="overflow-x-auto")
              div(class="grid grid-cols-[70px_repeat(7,minmax(120px,1fr))] gap-2 min-w-[900px]")
                
                //- Cabecera: Espacio vacío para la columna de horas
                div(class="bg-transparent")

                //- Cabecera: Los 7 días de la semana
                each dia in diasSemana
                  div(class="p-2 text-center font-bold text-gray-700 bg-gray-100 rounded-lg text-[13px] flex flex-col")
                    span= dia.nombre
                    span(class="text-[11px] font-normal text-gray-500")= dia.fechaISO

                - const horas = ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00']
                
                //- Cuerpo de la grilla (Horas y celdas por cada día)
                each hora in horas
                  div(class="flex items-center justify-center font-bold text-gray-500 text-[12px] bg-gray-50 rounded-lg")= hora
                  
                  each dia, i in diasSemana
                    if i === 5 || i === 6
                      div(class="min-h-[58px] p-2 rounded-lg bg-gray-100 border border-gray-200 select-none")
                    else
                      - const cita = citas.find(c => c.fecha === dia.fechaISO && c.hora.startsWith(hora.substring(0,2)))
                      
                      if cita
                        div(class="min-h-[58px] p-2 rounded-lg bg-amber-50 border border-amber-300 text-amber-900 text-[11px] flex flex-col justify-center text-center font-semibold leading-tight")
                          span= `${cita.paciente.nombre} ${cita.paciente.apellido}`
                          span(class="text-[10px] text-amber-700 font-normal mt-1") Ocupado
                      else
                        div(class="min-h-[58px] p-2 rounded-lg bg-emerald-50 border border-emerald-200 transition-colors cursor-default")
        else
          div(class="bg-white rounded-[16px] p-[40px] text-center border border-gray-200 shadow-sm")
            i(data-lucide="search", class="w-[40px] h-[40px] text-gray-300 mx-auto mb-[15px]")
            h3(class="text-[18px] font-bold text-gray-700 mb-[5px]") Ningún médico seleccionado
            p(class="text-[14px] text-gray-500") Selecciona un especialista en el filtro superior para visualizar su agenda de la semana.

    script.
      lucide.createIcons();