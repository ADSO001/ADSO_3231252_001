doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="description", content="Recuperación de contraseña para el sistema SIGCMI.")
    title SIGCMI - Recuperar Contraseña
    script(src="https://cdn.tailwindcss.com")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css", crossorigin="anonymous", referrerpolicy="no-referrer")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white font-sans")
    main(class="flex min-h-screen flex-col md:flex-row")

      //- Zona de la Imagen Estática (Izquierda)
      section(class="relative w-full h-[250px] md:w-[40%] md:h-screen md:sticky md:top-0", role="img", aria-label="Ilustración de un profesional de la salud")
        img(src="img/doctor2.jpg", alt="Doctor atendiendo consulta", loading="eager", class="w-full h-full object-cover block")

      //- Zona del Formulario (Derecha)
      section(class="w-full py-[40px] px-[20px] md:w-[60%] md:py-[40px] md:px-[80px] flex flex-col justify-between min-h-screen bg-white")

        //- Cabecera Superior con la marca SIGCMI
        header(class="flex justify-start items-center w-full")
          span(class="font-bold text-[14px] text-black tracking-wider") SIGCMI

        //- Contenedor Centrado (Logo Elevado + Caja)
        div(class="w-full max-w-[390px] mx-auto my-auto flex flex-col items-center text-center")

          //- Logo (Ubicado más arriba mediante un margen inferior más amplio)
          img(src="img/logo.png", alt="Logo corporativo SIGCMI", class="h-[95px] object-contain mb-[65px]")

          //- Caja de Recuperación
          div(class="w-full flex flex-col items-center")

            //- Ícono de Correo / Llave dentro de círculo gris
            div(class="w-[60px] h-[60px] bg-gray-100 rounded-full flex items-center justify-center mb-[20px] text-black text-[22px]", aria-hidden="true")
              i(class="fa-solid fa-envelope-open-text")

            //- Título e Instrucciones
            h1(class="text-[26px] font-bold text-[#1a1a1a] mb-[8px] m-0") ¿Olvidaste tu contraseña?
            p(class="text-[#888] text-[14px] mb-[30px] leading-relaxed") Ingresa tu email y te enviaremos una nueva contraseña.

            //- Formulario
            form(class="w-full flex flex-col items-start text-left mb-[20px]")
              div(class="w-full mb-[20px]")
                label(for="email", class="text-[13px] font-semibold text-[#333] mb-[8px] block") Correo electrónico
                input(type="email", id="email", name="email", placeholder="sigcmi@gmail.com", required=true, class="w-full p-[12px] border border-[#d1d5db] rounded-[6px] text-[14px] outline-none focus:border-black bg-white transition-colors")
                span(class="text-[11px] text-[#999] mt-[6px] block") Enviaremos una nueva contraseña a este correo.

              //- Botón Enviar
              button(type="button", onclick="enviar(event)", class="w-full bg-black text-white py-[14px] border-none rounded-[8px] text-[15px] font-bold cursor-pointer flex justify-center items-center gap-[10px] hover:bg-gray-800 transition-colors shadow-sm")
                i(class="fa-solid fa-paper-plane", aria-hidden="true")
                span Enviar

            //- Enlace para volver al Inicio de Sesión
            nav(class="mt-[10px]")
              a(href="/login", class="no-underline text-[13px] text-[#555] hover:text-black font-medium flex items-center gap-[6px] transition-colors")
                i(class="fa-solid fa-chevron-left text-[11px]", aria-hidden="true")
                |  Volver al inicio de sesión

        //- Pie transparente para equilibrar el espacio vertical
        div(class="h-[20px]")

    script(src="script/UHW08.js")