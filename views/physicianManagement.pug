doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title SIGCMI - Gestión de Médicos
    link(rel="icon", href="icono.png", type="image/png")
    script(src="https://cdn.tailwindcss.com")
    //- Lucide Icons (CDN)
    script(src="https://unpkg.com/lucide@latest")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    //- Mixin para tarjetas de doctor
    mixin tarjetaDoctor(img, especialidad, nombre, licencia, email, telefono, precio, dias)
      div(class="bg-white border border-gray-200 rounded-[8px] overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow")
        div(class="relative h-[180px] bg-gray-100")
          img(src=img, alt=nombre, class="w-full h-full object-cover")
          span(class="absolute top-[15px] right-[15px] bg-white px-[12px] py-[6px] rounded-[20px] text-[12px] font-bold text-gray-800 shadow-sm")= especialidad
        
        div(class="p-[20px] flex flex-col flex-1")
          h3(class="text-[18px] font-bold text-gray-900 mb-[4px]")= nombre
          p(class="text-[13px] text-gray-500 mb-[16px]")= licencia
          
          div(class="flex flex-col gap-[10px] mb-[16px]")
            div(class="flex items-center gap-[10px] text-[13px] text-gray-600")
              i(data-lucide="mail", class="w-[16px] h-[16px] text-gray-500 shrink-0")
              span= email
            div(class="flex items-center gap-[10px] text-[13px] text-gray-600")
              i(data-lucide="phone", class="w-[16px] h-[16px] text-gray-500 shrink-0")
              span= telefono
            div(class="flex items-center gap-[10px] text-[13px] text-gray-600")
              i(data-lucide="calendar", class="w-[16px] h-[16px] text-gray-500 shrink-0")
              strong(class="text-gray-900")= precio
              span(class="text-gray-400") Por consulta
          
          hr(class="border-0 border-t border-gray-200 my-[15px]")
          
          p(class="text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-[10px]") Horario de atención
          div(class="flex flex-wrap gap-[6px] mb-[20px]")
            each dia in dias
              span(class="border border-gray-200 bg-gray-50 px-[10px] py-[4px] rounded-[15px] text-[12px] text-gray-700")= dia
          
          div(class="flex gap-[10px] mt-auto")
            button(type="button", onclick="abrirPopUp()", class="flex-1 bg-white border border-gray-300 text-gray-800 py-[8px] rounded-[20px] font-bold text-[13px] hover:bg-gray-50 transition-colors cursor-pointer text-center") Editar
            a(href="UHW09.html", class="flex-1 bg-black text-white py-[8px] rounded-[20px] font-bold text-[13px] hover:opacity-80 transition-opacity no-underline text-center flex items-center justify-center") Ver agenda

    div(class="flex flex-col md:flex-row min-h-screen")
      //- BARRA LATERAL
      aside(class="w-full md:w-[260px] bg-white border-r border-gray-200 flex flex-col shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto")
        div(class="p-[20px] flex items-center gap-[10px] border-b border-gray-200")
          div(class="w-[60px] h-[60px] max-w-[60px] max-h-[60px]")
            img(src="img/logo.png", alt="logo", class="w-full h-full object-contain")
          h1(class="text-[20px] font-bold") SIGCMI

        nav(class="flex-1 p-[20px_10px] flex flex-col gap-[8px]")
          a(href="/adminPanel", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="layout-dashboard", class="w-[20px] h-[20px]")
            | Panel principal

          a(href="/appointmentScheduleAdmin", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="calendar", class="w-[20px] h-[20px]")
            | Agenda de citas

          a(href="/patientManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="users", class="w-[20px] h-[20px]")
            | Pacientes

          a(href="#", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#000000] rounded-[10px] text-[14px] font-bold bg-[#e0e0e0] no-underline")
            i(data-lucide="stethoscope", class="w-[20px] h-[20px]")
            | Médicos

          a(href="/managementSpecialities", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="user-check", class="w-[20px] h-[20px]")
            | Verificar Médicos

          a(href="/doctorsHours", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="clock", class="w-[20px] h-[20px]")
            | Horarios

        div(class="p-[20px] border-t border-gray-200 flex flex-col gap-[15px]")
          div(class="flex items-center gap-[10px]")
            div(class="w-[35px] h-[35px] rounded-full bg-black text-white flex items-center justify-center")
              i(data-lucide="user", class="w-[20px] h-[20px]")
            div(class="flex flex-col")
              span(class="text-[14px] font-bold text-gray-900") Admin
              span(class="text-[12px] text-gray-500") Administrador

          a(href="/login", class="no-underline")
            button(type="button", class="bg-black text-white px-[15px] py-[10px] rounded-[20px] flex items-center justify-center gap-[10px] font-bold text-[14px] w-fit cursor-pointer hover:opacity-80 transition-opacity border-none")
              i(data-lucide="log-out", class="w-[18px] h-[18px]")
              | Cerrar sesión

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 p-[30px] bg-[#fafafa]")
        //- ENCABEZADO
        header(class="mb-[25px]")
          h2(class="text-[24px] font-bold mb-[5px] text-gray-900") Gestión de Médicos
          p(class="text-[14px] text-gray-500 m-0") Administra la información y horarios de los médicos

        //- BARRA DE BÚSQUEDA
        div(class="flex items-center gap-[10px] bg-white border border-gray-200 rounded-[10px] p-[12px_15px] mb-[30px] shadow-sm")
          i(data-lucide="search", class="w-[20px] h-[20px] text-gray-400 shrink-0")
          input(
            type="text",
            placeholder="Buscar por nombre, especialidad o email...",
            class="border-none bg-transparent outline-none w-full text-[14px] text-gray-800 placeholder-gray-400"
          )

        //- GRILLA DE MÉDICOS
        div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[25px]")
          +tarjetaDoctor(
            "img/doctor1.png",
            "Medicina general",
            "Dr. María González",
            "Num. Tar. Pro-2024-001",
            "maria.gonzalez@sigcmi.com",
            "+1 234 567 8901",
            "50$",
            ["Lun: 08:00-14:00", "Mié: 08:00-14:00", "Vie: 08:00-14:00"]
          )

          +tarjetaDoctor(
            "img/doctor3.png",
            "Cardiología",
            "Dr. Carlos Rodríguez",
            "Num. Tar. Pro-2024-002",
            "carlos.rodriguez@sigcmi.com",
            "+1 234 567 8902",
            "80$",
            ["Mar: 09:00-17:00", "Jue: 09:00-17:00", "Vie: 08:00-14:00"]
          )

          +tarjetaDoctor(
            "img/doctor4.png",
            "Oftalmólogo",
            "Dr. Roberto Silva",
            "Num. Tar. Pro-2024-004",
            "roberto.silva@sigcmi.com",
            "+1 234 567 8904",
            "70$",
            ["Lun: 14:00-20:00", "Jue: 14:00-20:00", "Vie: 08:00-14:00"]
          )

    //- VENTANA EDICIÓN (POPUP MODAL)
    #ventanaEdicion(class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-[20px]")
      div(class="bg-white p-[25px] rounded-[12px] w-full max-w-[380px] shadow-lg flex flex-col gap-[15px]")
        div
          h3(class="text-[18px] font-bold text-gray-900 m-0") Editar Médico
          p(class="text-[13px] text-gray-500 m-0 mt-[4px]") Modifica la información del doctor
        
        div(class="flex flex-col gap-[12px]")
          input(type="text", placeholder="Nueva especialidad...", class="w-full p-[10px_12px] border border-gray-300 rounded-[8px] text-[14px] outline-none focus:border-black transition-colors")
          input(type="text", placeholder="Nuevo teléfono...", class="w-full p-[10px_12px] border border-gray-300 rounded-[8px] text-[14px] outline-none focus:border-black transition-colors")
          input(type="text", placeholder="Nuevo correo...", class="w-full p-[10px_12px] border border-gray-300 rounded-[8px] text-[14px] outline-none focus:border-black transition-colors")
          input(type="text", placeholder="Nuevo precio de consulta...", class="w-full p-[10px_12px] border border-gray-300 rounded-[8px] text-[14px] outline-none focus:border-black transition-colors")
        
        div(class="flex gap-[10px] mt-[5px]")
          button(type="button", onclick="cerrarPopUp()", class="flex-1 bg-gray-100 text-gray-800 py-[10px] rounded-[8px] font-bold text-[14px] hover:bg-gray-200 transition-colors cursor-pointer border-none") Cancelar
          button(type="button", onclick="cerrarPopUp()", class="flex-1 bg-black text-white py-[10px] rounded-[8px] font-bold text-[14px] hover:opacity-80 transition-opacity cursor-pointer border-none") Guardar

    //- Inicialización de iconos Lucide y scripts
    script.
      lucide.createIcons();
