doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="description", content="Restablecer contraseña para el sistema SIGCMI.")
    title SIGCMI - Restablecer Contraseña
    script(src="https://cdn.tailwindcss.com")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css", crossorigin="anonymous", referrerpolicy="no-referrer")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white font-sans")
    main(class="flex min-h-screen flex-col md:flex-row")

      //- Zona de la Imagen Estática (Izquierda)
      section(class="relative w-full h-[250px] md:w-[40%] md:h-screen md:sticky md:top-0", role="img", aria-label="Ilustración de un profesional de la salud")
        img(src="/img/doctor2.jpg", alt="Doctor atendiendo consulta", loading="eager", class="w-full h-full object-cover block")

      //- Zona del Formulario (Derecha)
      section(class="w-full py-[40px] px-[20px] md:w-[60%] md:py-[40px] md:px-[80px] flex flex-col justify-between min-h-screen bg-white")

        //- Cabecera Superior con la marca SIGCMI
        header(class="flex justify-start items-center w-full")
          span(class="font-bold text-[14px] text-black tracking-wider") SIGCMI

        //- Contenedor Centrado
        div(class="w-full max-w-[390px] mx-auto my-auto flex flex-col items-center text-center")

          img(src="/img/logo.png", alt="Logo corporativo SIGCMI", class="h-[95px] object-contain mb-[45px]")

          div(class="w-full flex flex-col items-center")

            div(class="w-[60px] h-[60px] bg-gray-100 rounded-full flex items-center justify-center mb-[20px] text-black text-[22px]", aria-hidden="true")
              i(class="fa-solid fa-lock")

            h1(class="text-[26px] font-bold text-[#1a1a1a] mb-[8px] m-0") Restablecer Contraseña
            p(class="text-[#888] text-[14px] mb-[30px] leading-relaxed") Ingresa tu nueva contraseña para tu cuenta en SIGCMI.

            //- Bloque de errores conectados con express-validator
            if errores
              div(class="w-full max-w-md mx-auto mb-4")
                each error in errores
                  p(class="bg-red-600 text-white text-xs text-center p-2 mb-1 font-bold rounded")= error.msg

            //- Formulario POST que apunta a la ruta con el token
            form(method="POST" class="w-full flex flex-col items-start text-left mb-[20px]")
              
              //- Token CSRF de seguridad
              input(type="hidden" name="_csrf" value=csrfToken)

              div(class="w-full mb-[20px]")
                label(for="password", class="text-[13px] font-semibold text-[#333] mb-[8px] block") Nueva contraseña
                input(type="password", id="password", name="password", placeholder="Mínimo 6 caracteres", required=true, class="w-full p-[12px] border border-[#d1d5db] rounded-[6px] text-[14px] outline-none focus:border-black bg-white transition-colors")

              div(class="w-full mb-[20px]")
                label(for="repeat_password", class="text-[13px] font-semibold text-[#333] mb-[8px] block") Confirmar contraseña
                input(type="password", id="repeat_password", name="repeat_password", placeholder="Repite tu contraseña", required=true, class="w-full p-[12px] border border-[#d1d5db] rounded-[6px] text-[14px] outline-none focus:border-black bg-white transition-colors")

              button(type="submit", class="w-full bg-black text-white py-[14px] border-none rounded-[8px] text-[15px] font-bold cursor-pointer flex justify-center items-center gap-[10px] hover:bg-gray-800 transition-colors shadow-sm")
                i(class="fa-solid fa-floppy-disk", aria-hidden="true")
                span Guardar Contraseña

            nav(class="mt-[10px]")
              a(href="/login", class="no-underline text-[13px] text-[#555] hover:text-black font-medium flex items-center gap-[6px] transition-colors")
                i(class="fa-solid fa-chevron-left text-[11px]", aria-hidden="true")
                |  Volver al inicio de sesión

        div(class="h-[20px]")