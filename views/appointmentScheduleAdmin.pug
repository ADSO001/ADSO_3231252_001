doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title SIGCMI - Agenda de Citas
    link(rel="stylesheet" href="/css/output.css")
    //- Lucide Icons (CDN)
    script(src="https://unpkg.com/lucide@latest")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    div(class="flex flex-col md:flex-row min-h-screen")
      
      //- BARRA LATERAL (SIDEBAR)
      aside(class="w-full md:w-[260px] bg-white border-r border-gray-200 flex flex-col shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto")
        div(class="p-[20px] flex items-center gap-[10px] border-b border-gray-200")
          div(class="w-[60px] h-[60px] max-w-[60px] max-h-[60px]")
            img(src="img/logo.png", alt="logo", class="w-full h-full object-contain")
          h1(class="text-[20px] font-bold") SIGCMI

        nav(class="flex-1 p-[20px_10px] flex flex-col gap-[8px]")
          a(href="/adminPanel", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="layout-dashboard", class="w-[20px] h-[20px]")
            | Panel principal

          a(href="/appointmentScheduleAdmin", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#000000] rounded-[10px] text-[14px] font-bold bg-[#e0e0e0] no-underline")
            i(data-lucide="calendar", class="w-[20px] h-[20px]")
            | Agenda de citas

          a(href="/patientManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="users", class="w-[20px] h-[20px]")
            | Pacientes

          a(href="/physicianManagement  ", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="stethoscope", class="w-[20px] h-[20px]")
            | Médicos

          a(href="/managementSpecialities", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="user-check", class="w-[20px] h-[20px]")
            | Verificar Médicos

          a(href="/doctorsHours", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="clock", class="w-[20px] h-[20px]")
            | Horarios

        div(class="p-[20px] border-t border-gray-200 flex flex-col gap-[15px]")
          div(class="flex items-center gap-[10px]")
            div(class="w-[35px] h-[35px] rounded-full bg-black text-white flex items-center justify-center")
              i(data-lucide="user", class="w-[20px] h-[20px]")
            div(class="flex flex-col")
              span(class="text-[14px] font-bold text-gray-900") Admin
              span(class="text-[12px] text-gray-500") Administrador

          a(href="/login", class="no-underline")
            button(type="button", class="bg-black text-white px-[15px] py-[10px] rounded-[20px] flex items-center justify-center gap-[10px] font-bold text-[14px] w-fit cursor-pointer hover:opacity-80 transition-opacity border-none")
              i(data-lucide="log-out", class="w-[18px] h-[18px]")
              | Cerrar sesión

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 p-[30px] bg-[#fafafa]")
        
        //- ENCABEZADO
        header(class="mb-[25px]")
          h2(class="text-[22px] font-bold mb-[5px] text-gray-900") Agenda de Citas
          p(class="text-[14px] text-gray-500 m-0") Gestiona todas las citas médicas del centro

        //- BARRA DE FILTROS
        section(class="flex flex-col sm:flex-row gap-[15px] mb-[30px] items-stretch sm:items-center")
          div(class="flex-1 min-w-[250px] flex items-center bg-[#f0f0f0] px-[15px] py-[10px] rounded-[8px] gap-[10px]")
            i(data-lucide="search", class="w-[18px] h-[18px] text-gray-500")
            input#buscarCita(type="text", placeholder="Buscar por paciente, médico o motivo...", class="border-none bg-transparent outline-none w-full text-[14px] text-gray-800")
          
          select#filtroEstadoCita(class="px-[15px] py-[10px] border border-gray-200 rounded-[8px] bg-white text-[14px] text-gray-600 outline-none cursor-pointer")
            option(value="") Todos los estados
            option(value="pendiente") Pendientes
            option(value="completada") Completadas
            option(value="cancelada") Canceladas

        //- LISTA DE AGENDA
        section(class="bg-white border border-gray-100 rounded-[12px] p-[20px]")
          div(class="mb-[15px]")
            i(data-lucide="calendar", class="w-[20px] h-[20px] text-gray-700")

          div#listaCitas(class="flex flex-col gap-[15px]")
            if citas && citas.length > 0
              each cita in citas
                - var fechaTexto = String(cita.fecha).substring(0, 10).split('-');
                - var fechaFormateada = fechaTexto.length === 3 ? `${fechaTexto[2]}/${fechaTexto[1]}/${fechaTexto[0]}` : cita.fecha;
                
                // Mapeo seguro de textos y colores según el estado real de la BD
                - var estadoTexto = cita.estado === 'completada' ? 'Completada' : (cita.estado === 'cancelada' ? 'Cancelada' : (cita.estado === 'confirmada' ? 'Confirmada' : 'Pendiente'));
                - var estadoClase = cita.estado === 'completada' ? 'bg-green-600 text-white' : (cita.estado === 'cancelada' ? 'bg-red-600 text-white' : (cita.estado === 'confirmada' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-800'));
                
                div.cita-item(class="border border-gray-200 rounded-[10px] p-[20px]", data-estado=cita.estado, data-busqueda=((cita.paciente ? cita.paciente.nombre + ' ' + cita.paciente.apellido + ' ' + cita.paciente.email : '') + ' ' + (cita.medico ? cita.medico.nombre + ' ' + cita.medico.apellido : '') + ' ' + cita.motivo).toLowerCase())
                  div(class="flex flex-wrap justify-between items-center mb-[15px] gap-[10px]")
                    div(class="flex flex-wrap items-center gap-[15px]")
                      span(class="font-bold text-[15px]")= fechaFormateada
                      span(class="text-gray-600 text-[15px]")= String(cita.hora).substring(0, 5)
                      span(class=`px-[12px] py-[4px] rounded-[12px] text-[11px] font-bold ${estadoClase}`)= estadoTexto
                  div(class="flex flex-col md:flex-row justify-between gap-[20px]")
                    div(class="flex-1 min-w-[200px]")
                      p(class="mb-[6px] text-[14px]")
                        span(class="text-gray-500") Paciente: 
                        span(class="font-semibold text-gray-900")= cita.paciente ? `${cita.paciente.nombre} ${cita.paciente.apellido}` : 'No disponible'
                      p(class="mb-[6px] text-[14px]")
                        span(class="text-gray-500") Motivo: 
                        span(class="text-gray-700")= cita.motivo
                    div(class="flex-1 min-w-[200px]")
                      p(class="mb-[6px] text-[14px]")
                        span(class="text-gray-500") Médico: 
                        span(class="font-semibold text-gray-900")= cita.medico ? `Dr. ${cita.medico.nombre} ${cita.medico.apellido}` : 'No asignado'
            else
              div(class="p-8 text-center text-gray-500 bg-gray-50 border border-dashed border-gray-300 rounded-lg")
                p(class="font-medium") No hay citas registradas en el sistema.
            p#sinResultadosCitas(class="hidden p-8 text-center text-gray-500") No se encontraron citas con esos filtros.

    //- Script para inicializar los íconos de Lucide y filtros
    script.
      lucide.createIcons();

      const buscarCita = document.getElementById('buscarCita');
      const filtroEstadoCita = document.getElementById('filtroEstadoCita');
      const tarjetasCita = document.querySelectorAll('.cita-item');
      const sinResultadosCitas = document.getElementById('sinResultadosCitas');

      function filtrarCitas() {
        const texto = buscarCita.value.toLowerCase().trim();
        const estado = filtroEstadoCita.value;
        let visibles = 0;

        tarjetasCita.forEach((tarjeta) => {
          const coincideTexto = tarjeta.dataset.busqueda.includes(texto);
          const coincideEstado = !estado || tarjeta.dataset.estado === estado;
          const mostrar = coincideTexto && coincideEstado;

          tarjeta.classList.toggle('hidden', !mostrar);
          if (mostrar) visibles++;
        });

        sinResultadosCitas.classList.toggle('hidden', visibles > 0);
      }

      buscarCita.addEventListener('input', filtrarCitas);
      filtroEstadoCita.addEventListener('change', filtrarCitas);