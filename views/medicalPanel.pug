doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title SIGCMI - Panel Médico
    link(rel="stylesheet" href="/css/output.css")
    link(rel="stylesheet" href="/css/notificaciones.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    link(rel="icon", href="icono.png", type="image/png")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    header(class="flex items-center justify-between border-b border-gray-200 px-[20px] py-[10px]")
      div(class="flex items-center")
        img(src="img/logo.png", alt="logo", class="w-[90px] h-[85px] object-contain border-r border-gray-200 pr-[10px] mr-[10px]")
        div(class="border border-gray-300 rounded-[8px] px-[15px] py-[5px] ml-[20px]")
          p#nombreMedico(class="text-[14px] font-bold m-0")= medico ? `Dr. ${medico.nombre}` : (usuario ? `Dr. ${usuario.nombre}` : 'Dr. Médico')
          p#especialidadMedico(class="text-[12px] text-gray-500 m-0")= medico && medico.especialidad ? medico.especialidad : (usuario && usuario.especialidad ? usuario.especialidad : 'Medicina General')

      div(class="flex items-center gap-[10px] ml-auto")
        a(href="/medico/mi-agenda", class="no-underline")
          button(type="button", class="bg-gray-100 border border-gray-300 text-black px-[15px] h-[35px] rounded-[10px] flex items-center gap-[8px] text-[14px] cursor-pointer hover:bg-gray-200 transition-colors font-medium")
            i(class="fa-solid fa-calendar-days text-gray-600")
            | Mi Agenda

        a(href="/login", class="no-underline")
          button#logout(type="button", class="bg-black text-white px-[15px] h-[35px] rounded-[10px] flex items-center gap-[8px] text-[14px] cursor-pointer hover:opacity-70 transition-opacity")
            i(class="fa-solid fa-right-from-bracket")
            | Cerrar sesión

    main(class="p-[20px]")
      section(class="grid grid-cols-1 md:grid-cols-3 gap-[20px] mb-[20px]")
        div(class="border border-gray-300 rounded-[8px] p-[15px] relative shadow-sm bg-white")
          i(class="fa fa-calendar-day absolute top-[10px] right-[10px] text-[22px] text-gray-500")
          h3(class="text-[14px] font-bold mb-[5px]") Citas hoy
          p#citasHoy(class="text-[28px] font-bold m-0")= citasHoy ? citasHoy.length : 0
          p(class="text-[12px] text-gray-500 m-0") Citas programadas

        div(class="border border-gray-300 rounded-[8px] p-[15px] relative shadow-sm bg-white")
          i(class="fa fa-clock absolute top-[10px] right-[10px] text-[22px] text-gray-500")
          h3(class="text-[14px] font-bold mb-[5px]") Próximas citas
          p#proxCita(class="text-[28px] font-bold m-0")= proximasCitas ? proximasCitas.length : 0
          p(class="text-[12px] text-gray-500 m-0") Esta semana y siguientes

        div(class="border border-gray-300 rounded-[8px] p-[15px] relative shadow-sm bg-white")
          i(class="fa fa-folder-open absolute top-[10px] right-[10px] text-[22px] text-gray-500")
          h3(class="text-[14px] font-bold mb-[5px]") Consultas totales
          p#ConTotal(class="text-[28px] font-bold m-0")= totalCitas || 0
          p(class="text-[12px] text-gray-500 m-0") Registros en el sistema

      section(class="flex flex-col sm:flex-row gap-[10px] mb-[20px]")
        button#tabHoy(onclick="cambiarPestana('hoy')", class="flex-1 h-[40px] text-[15px] text-left px-[20px] border border-gray-300 rounded-[10px] bg-gray-300 font-medium cursor-pointer transition-colors flex items-center gap-[8px]")
          i(class="fa fa-calendar-day")
          | Agenda de hoy

        button#tabProximas(onclick="cambiarPestana('proximas')", class="flex-1 h-[40px] text-[15px] text-left px-[20px] border border-gray-300 rounded-[10px] bg-white hover:bg-gray-100 transition-colors cursor-pointer text-black font-medium flex items-center gap-[8px]")
          i(class="fa fa-clock")
          | Próximas citas

        button#tabHistorial(onclick="cambiarPestana('historial')", class="flex-1 h-[40px] text-[15px] text-left px-[20px] border border-gray-300 rounded-[10px] bg-white hover:bg-gray-100 transition-colors cursor-pointer text-black font-medium flex items-center gap-[8px]")
          i(class="fa fa-folder")
          | Historias clínicas

      //- SECCIÓN 1: Agenda de hoy
      section#seccionHoy(class="border border-gray-300 rounded-[8px] p-[25px] bg-white shadow-sm")
        h4(class="text-[18px] font-bold text-black mb-[2px]") Agenda del día
        p(class="text-[14px] text-gray-500 mb-[20px]") Tus consultas programadas para hoy

        div#lista-pacientes(class="flex flex-col gap-[15px]")
          if citasHoy && citasHoy.length > 0
            each cita in citasHoy
              div(class="flex flex-col md:flex-row justify-between items-start md:items-center p-[20px] border border-gray-200 rounded-[12px] bg-white gap-[15px] shadow-sm")
                div
                  div(class="flex items-center mb-[8px]")
                    span(class="font-bold text-[16px] text-black")= cita.hora
                    if cita.estado === 'cancelada'
                      span(class="text-[11px] px-[12px] py-[3px] rounded-[15px] ml-[15px] bg-red-100 text-red-800 capitalize font-bold")= cita.estado
                    else
                      span(class="text-[11px] px-[12px] py-[3px] rounded-[15px] ml-[15px] bg-blue-100 text-blue-800 capitalize font-bold")= cita.estado
                  div(class="flex flex-col gap-[4px] text-[14px]")
                    div(class="flex")
                      span(class="text-gray-400 w-[75px]") Paciente:
                      span(class="font-bold text-gray-800")= `${cita.paciente.nombre} ${cita.paciente.apellido}`
                    div(class="flex")
                      span(class="text-gray-400 w-[75px]") Motivo:
                      span(class="text-gray-600")= cita.motivo
                if cita.estado !== 'cancelada' && cita.estado !== 'completada'
                  div(class="flex flex-col gap-[8px] w-full md:w-auto")
                    button(type="button" onclick=`abrirModalCrearHistoria('${cita.id}', '${cita.paciente.nombre} ${cita.paciente.apellido}')` class="w-full md:w-[160px] p-[8px] rounded-[8px] text-[12px] font-bold bg-black text-white cursor-pointer hover:opacity-70 transition-opacity") Atender Paciente
                    div(class="flex gap-[8px] w-full md:w-[160px]")
                      button(type="button" onclick=`abrirModalReprogramar('${cita.id}')` class="flex-1 p-[8px] rounded-[8px] text-[11px] font-bold bg-blue-100 text-blue-700 cursor-pointer hover:bg-blue-200 transition-colors") Reprogramar
                      button(type="button" onclick=`cancelarCita('${cita.id}')` class="flex-1 p-[8px] rounded-[8px] text-[11px] font-bold bg-red-100 text-red-700 cursor-pointer hover:bg-red-200 transition-colors") Cancelar
          else
            div(class="text-center py-[40px] border border-dashed border-gray-300 rounded-[12px]")
              i(class="fa fa-user-clock text-[36px] text-gray-300 mb-[10px]")
              p(class="text-gray-500 text-[14px] m-0") No hay citas programadas para el día de hoy.

      //- SECCIÓN 2: Próximas Citas
      section#seccionProximas(class="hidden border border-gray-300 rounded-[8px] p-[25px] bg-white shadow-sm")
        h4(class="text-[18px] font-bold text-black mb-[2px]") Próximas citas
        p(class="text-[14px] text-gray-500 mb-[20px]") Consultas agendadas para los próximos días
        
        div#lista-proximas(class="flex flex-col gap-[15px]")
          if proximasCitas && proximasCitas.length > 0
            each cita in proximasCitas
              div(class="flex flex-col md:flex-row justify-between items-start md:items-center p-[20px] border border-gray-200 rounded-[12px] bg-white gap-[15px] shadow-sm")
                div
                  div(class="flex items-center mb-[8px]")
                    span(class="font-bold text-[16px] text-black")= `${cita.fecha} | ${cita.hora}`
                    if cita.estado === 'cancelada'
                      span(class="text-[11px] px-[12px] py-[3px] rounded-[15px] ml-[15px] bg-red-100 text-red-800 capitalize font-bold")= cita.estado
                    else
                      span(class="text-[11px] px-[12px] py-[3px] rounded-[15px] ml-[15px] bg-yellow-100 text-yellow-800 capitalize font-bold")= cita.estado
                  div(class="flex flex-col gap-[4px] text-[14px]")
                    div(class="flex")
                      span(class="text-gray-400 w-[75px]") Paciente:
                      span(class="font-bold text-gray-800")= `${cita.paciente.nombre} ${cita.paciente.apellido}`
                    div(class="flex")
                      span(class="text-gray-400 w-[75px]") Motivo:
                      span(class="text-gray-600")= cita.motivo
                if cita.estado !== 'cancelada' && cita.estado !== 'completada'
                  div(class="flex flex-col gap-[8px] w-full md:w-auto")
                    button(type="button" onclick=`abrirModalCrearHistoria('${cita.id}', '${cita.paciente.nombre} ${cita.paciente.apellido}')` class="w-full md:w-[160px] p-[8px] rounded-[8px] text-[12px] font-bold bg-black text-white cursor-pointer hover:opacity-70 transition-opacity") Atender Paciente
                    div(class="flex gap-[8px] w-full md:w-[160px]")
                      button(type="button" onclick=`abrirModalReprogramar('${cita.id}')` class="flex-1 p-[8px] rounded-[8px] text-[11px] font-bold bg-blue-100 text-blue-700 cursor-pointer hover:bg-blue-200 transition-colors") Reprogramar
                      button(type="button" onclick=`cancelarCita('${cita.id}')` class="flex-1 p-[8px] rounded-[8px] text-[11px] font-bold bg-red-100 text-red-700 cursor-pointer hover:bg-red-200 transition-colors") Cancelar
          else
            div(class="text-center py-[40px] border border-dashed border-gray-300 rounded-[12px]")
              i(class="fa fa-clock text-[36px] text-gray-300 mb-[10px]")
              p(class="text-gray-500 text-[14px] m-0") No hay citas agendadas próximamente.

      //- SECCIÓN 3: Historias clínicas de pacientes atendidos
      section#seccionHistorial(class="hidden border border-gray-300 rounded-[8px] p-[25px] bg-white shadow-sm")
        h4(class="text-[18px] font-bold text-black mb-[2px]") Historias clínicas
        p(class="text-[14px] text-gray-500 mb-[20px]") Consulta los registros clínicos que has elaborado y las historias de pacientes que has atendido.
        div(class="flex flex-col gap-[15px]")
          if historiasClinicas && historiasClinicas.length > 0
            each historia in historiasClinicas
              div(class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-[18px] border border-gray-200 rounded-[12px] bg-gray-50")
                div
                  p(class="text-[11px] uppercase font-bold tracking-wide text-gray-500 mb-1")= new Date(historia.fecha_elaboracion).toLocaleString('es-CO', { timeZone: 'America/Bogota' })
                  h3(class="text-[15px] font-bold text-gray-900")= `${historia.paciente.nombre} ${historia.paciente.apellido}`
                  p(class="text-[13px] text-gray-600 mt-1")= `Motivo: ${historia.motivo}`
                  p(class="text-[13px] text-gray-600 mt-1")= `Diagnóstico: ${historia.diagnostico_principal || 'No registrado'} · CIE-10: ${historia.codigo_cie10 || 'No registrado'}`
                  if historia.medico
                    p(class="text-[12px] text-gray-500 mt-1")= `Atención registrada por: Dr. ${historia.medico.nombre} ${historia.medico.apellido}`
                  if historia.cita
                    p(class="text-[12px] text-gray-500 mt-1")= `Cita: ${historia.cita.fecha} · ${historia.cita.hora}`
                div(class="flex gap-2 shrink-0")
                  a(href=`/historia-clinica/${historia.id}` class="bg-black text-white px-[14px] py-[9px] rounded-[7px] text-[12px] font-bold no-underline") Ver historia
                  a(href=`/historia-clinica/pdf/${historia.id}` target="_blank" class="bg-red-100 text-red-700 px-[14px] py-[9px] rounded-[7px] text-[12px] font-bold no-underline") PDF
          else
            div(class="text-center py-[40px] border border-dashed border-gray-300 rounded-[12px]")
              i(class="fa fa-file-medical text-[36px] text-gray-300 mb-[10px]")
              p(class="text-gray-500 text-[14px] m-0") Aún no has registrado historias clínicas.

    //- MODAL 2: Historia clínica ambulatoria ampliada
    div#modalCrearHistoria(class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-[15px] overflow-y-auto")
      div(class="bg-white w-full max-w-[1000px] rounded-[15px] shadow-2xl overflow-hidden my-6")
        div(class="p-[20px] border-b border-gray-200 bg-gray-50 flex justify-between items-center gap-3")
          div
            h2(class="text-[18px] font-bold text-black m-0") Historia clínica ambulatoria
            p(class="text-[12px] text-gray-500 mt-1") Registra la información pertinente a esta atención. Los campos no aplicables pueden dejarse vacíos.
          button(type="button", onclick="cerrarModalCrearHistoria()", class="text-gray-500 hover:text-black font-bold text-[22px]") &times;
        form#formCrearHistoria(onsubmit="guardarHistoria(event)", class="p-[20px] flex flex-col gap-[18px] text-[14px] max-h-[82vh] overflow-y-auto")
          input#citaIdHistoria(type="hidden", name="citaId")
          input(type="hidden", name="_csrf", value=csrfToken)
          div(class="flex justify-between border border-blue-100 bg-blue-50 p-3 rounded-lg")
            span(class="font-bold text-gray-700") Paciente:
            span#crearPacienteNombre(class="text-gray-900 font-semibold") -
          section(class="border-t border-gray-200 pt-4")
            h3(class="font-bold text-blue-800 mb-3") 1. Identificación de la atención
            div(class="grid grid-cols-1 md:grid-cols-2 gap-3")
              div(class="flex flex-col gap-1")
                label(for="motivoConsulta", class="text-xs font-semibold text-gray-600") Motivo de consulta
                textarea#motivoConsulta(name="motivoConsulta", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="finalidadConsulta", class="text-xs font-semibold text-gray-600") Finalidad de la consulta
                input#finalidadConsulta(name="finalidadConsulta", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="causaExterna", class="text-xs font-semibold text-gray-600") Causa externa
                input#causaExterna(name="causaExterna", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="entidadResponsable", class="text-xs font-semibold text-gray-600") EPS / entidad responsable
                input#entidadResponsable(name="entidadResponsable", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="tipoUsuario", class="text-xs font-semibold text-gray-600") Tipo de usuario
                input#tipoUsuario(name="tipoUsuario", type="text", placeholder="Contributivo, subsidiado, particular...", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="regimenAfiliacion", class="text-xs font-semibold text-gray-600") Régimen de afiliación
                input#regimenAfiliacion(name="regimenAfiliacion", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="sedeAtencion", class="text-xs font-semibold text-gray-600") Sede o lugar de atención
                input#sedeAtencion(name="sedeAtencion", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="modalidadAtencion", class="text-xs font-semibold text-gray-600") Modalidad de atención
                input#modalidadAtencion(name="modalidadAtencion", type="text", placeholder="Presencial, teleconsulta...", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="acompanante", class="text-xs font-semibold text-gray-600") Acompañante o responsable
                input#acompanante(name="acompanante", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="parentescoAcompanante", class="text-xs font-semibold text-gray-600") Parentesco
                input#parentescoAcompanante(name="parentescoAcompanante", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="telefonoAcompanante", class="text-xs font-semibold text-gray-600") Teléfono del acompañante
                input#telefonoAcompanante(name="telefonoAcompanante", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
          section(class="border-t border-gray-200 pt-4")
            h3(class="font-bold text-blue-800 mb-3") 2. Antecedentes
            div(class="grid grid-cols-1 md:grid-cols-2 gap-3")
              div(class="flex flex-col gap-1")
                label(for="antecedentesPersonales", class="text-xs font-semibold text-gray-600") Antecedentes personales
                textarea#antecedentesPersonales(name="antecedentesPersonales", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="antecedentesFamiliares", class="text-xs font-semibold text-gray-600") Antecedentes familiares
                textarea#antecedentesFamiliares(name="antecedentesFamiliares", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="antecedentesQuirurgicos", class="text-xs font-semibold text-gray-600") Antecedentes quirúrgicos
                textarea#antecedentesQuirurgicos(name="antecedentesQuirurgicos", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="antecedentesFarmacologicos", class="text-xs font-semibold text-gray-600") Antecedentes farmacológicos
                textarea#antecedentesFarmacologicos(name="antecedentesFarmacologicos", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="alergias", class="text-xs font-semibold text-gray-600") Alergias
                textarea#alergias(name="alergias", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="antecedentesPatologicos", class="text-xs font-semibold text-gray-600") Antecedentes patológicos
                textarea#antecedentesPatologicos(name="antecedentesPatologicos", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="habitos", class="text-xs font-semibold text-gray-600") Hábitos y antecedentes relevantes
                textarea#habitos(name="habitos", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="antecedentesGinecoObstetricos", class="text-xs font-semibold text-gray-600") Antecedentes ginecológicos y obstétricos (si aplica)
                textarea#antecedentesGinecoObstetricos(name="antecedentesGinecoObstetricos", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
          section(class="border-t border-gray-200 pt-4")
            h3(class="font-bold text-blue-800 mb-3") 3. Enfermedad actual
            div(class="grid grid-cols-1 md:grid-cols-2 gap-3")
              div(class="flex flex-col gap-1")
                label(for="enfermedadActual", class="text-xs font-semibold text-gray-600") Descripción de la enfermedad actual
                textarea#enfermedadActual(name="enfermedadActual", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="fechaInicioSintomas", class="text-xs font-semibold text-gray-600") Fecha de inicio
                input#fechaInicioSintomas(name="fechaInicioSintomas", type="date", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="tiempoEvolucion", class="text-xs font-semibold text-gray-600") Tiempo de evolución
                input#tiempoEvolucion(name="tiempoEvolucion", type="text", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]")
              div(class="flex flex-col gap-1")
                label(for="sintomasAsociados", class="text-xs font-semibold text-gray-600") Síntomas asociados
                textarea#sintomasAsociados(name="sintomasAsociados", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="factoresMejoranEmpeoran", class="text-xs font-semibold text-gray-600") Factores que mejoran o empeoran los síntomas
                textarea#factoresMejoranEmpeoran(name="factoresMejoranEmpeoran", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="tratamientosPrevios", class="text-xs font-semibold text-gray-600") Tratamientos previos
                textarea#tratamientosPrevios(name="tratamientosPrevios", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
          section(class="border-t border-gray-200 pt-4")
            h3(class="font-bold text-blue-800 mb-3") 4. Revisión por sistemas
            div(class="grid grid-cols-1 md:grid-cols-2 gap-3")
              div(class="flex flex-col gap-1")
                label(for="revisionCardiovascular", class="text-xs font-semibold text-gray-600") Sistema cardiovascular
                textarea#revisionCardiovascular(name="revisionCardiovascular", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="revisionRespiratoria", class="text-xs font-semibold text-gray-600") Sistema respiratorio
                textarea#revisionRespiratoria(name="revisionRespiratoria", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="revisionDigestiva", class="text-xs font-semibold text-gray-600") Sistema digestivo
                textarea#revisionDigestiva(name="revisionDigestiva", rows="2", class="border border-gray-300 rounded-[8px] p-[9px] text-[13px]", placeholder="Registrar información clínica..." )
              div(class="flex flex-col gap-1")
                label(for="revisionNeurologica", class="text-xs font-semibold text-gray-600") Sistema neurológico
