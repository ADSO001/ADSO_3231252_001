        div(class="p-[20px] border-b border-gray-200 bg-gray-50")
          h2(class="text-[18px] font-bold text-gray-900 m-0") Reprogramar Cita
        form#formReprogramar(onsubmit="guardarReprogramacion(event)", class="p-[22px] flex flex-col gap-[15px] text-[14px]")
          input#citaIdReprogramar(type="hidden")
          
          div(class="flex flex-col gap-[6px]")
            label(for="nuevaFecha", class="font-bold text-gray-700 text-[13px]") Nueva Fecha:
            input#nuevaFecha(type="date", required, class="border border-gray-300 rounded-[8px] p-[11px] outline-none text-[13px]")
            
          div(class="flex flex-col gap-[6px]")
            label(for="nuevaHora", class="font-bold text-gray-700 text-[13px]") Nueva Hora:
            input#nuevaHora(type="time", required, class="border border-gray-300 rounded-[8px] p-[11px] outline-none text-[13px]")
            
          div(class="flex justify-end gap-[10px] mt-[10px]")
            button(type="button", onclick="cerrarModalReprogramar()", class="bg-gray-100 text-gray-800 border border-gray-300 px-[18px] py-[9px] rounded-[8px] font-bold text-[13px] hover:bg-gray-200 transition-colors cursor-pointer") Cancelar
            button(type="submit", class="btn-pastel-blue flex-none px-[20px] text-[13px]") Reprogramar

    script.
      async function decidirSolicitud(event, formulario, decision) {
        event.preventDefault();
        const esConfirmacion = decision === 'confirmada';
        const continuar = await confirmarEnAplicacion({
          titulo: esConfirmacion ? 'Confirmar cita' : 'Rechazar solicitud',
          mensaje: esConfirmacion ? '¿Deseas confirmar esta cita?' : '¿Deseas rechazar esta solicitud de cita?',
          textoConfirmar: esConfirmacion ? 'Sí, confirmar' : 'Sí, rechazar',
          peligro: !esConfirmacion
        });
        if (!continuar) return false;

        const boton = formulario.querySelector('button[type="submit"]');
        if (boton) { boton.disabled = true; boton.textContent = esConfirmacion ? 'Confirmando...' : 'Rechazando...'; }
        try {
          const datos = new URLSearchParams(new FormData(formulario));
          const respuesta = await fetch(formulario.action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded',
              'CSRF-Token': datos.get('_csrf') || document.getElementById('csrfToken').value
            },
            body: datos.toString()
          });
          const resultado = await respuesta.json().catch(() => ({}));
          if (!respuesta.ok) throw new Error(resultado.error || 'No fue posible actualizar la solicitud.');
          mostrarNotificacion({
            tipo: 'success',
            titulo: esConfirmacion ? 'Cita confirmada' : 'Solicitud rechazada',
            mensaje: esConfirmacion ? 'La cita fue confirmada y se notificó al paciente por correo.' : 'La solicitud fue rechazada y se notificó al paciente por correo.'
          });
          window.setTimeout(() => window.location.reload(), 1000);
        } catch (error) {
          if (boton) { boton.disabled = false; boton.textContent = esConfirmacion ? 'Confirmar' : 'Rechazar'; }
          mostrarNotificacion({ tipo: 'error', titulo: 'No se pudo actualizar la cita', mensaje: error.message || 'Inténtalo nuevamente.' });
        }
        return false;
      }

      function cambiarPestana(pestana) {
        const seccionSolicitudes = document.getElementById('seccionSolicitudes');
        const seccionHoy = document.getElementById('seccionHoy');
        const seccionProximas = document.getElementById('seccionProximas');
        const seccionHistorial = document.getElementById('seccionHistorial');

        const tabSolicitudes = document.getElementById('tabSolicitudes');
        const tabHoy = document.getElementById('tabHoy');
        const tabProximas = document.getElementById('tabProximas');
        const tabHistorial = document.getElementById('tabHistorial');

        seccionSolicitudes.classList.add('hidden');
        seccionHoy.classList.add('hidden');
        seccionProximas.classList.add('hidden');
        seccionHistorial.classList.add('hidden');

        tabSolicitudes.classList.remove('is-active');
        tabHoy.classList.remove('is-active');
        tabProximas.classList.remove('is-active');
        tabHistorial.classList.remove('is-active');

        if (pestana === 'solicitudes') {
          seccionSolicitudes.classList.remove('hidden');
          tabSolicitudes.classList.add('is-active');
        } else if (pestana === 'hoy') {
          seccionHoy.classList.remove('hidden');
          tabHoy.classList.add('is-active');
        } else if (pestana === 'proximas') {
          seccionProximas.classList.remove('hidden');
          tabProximas.classList.add('is-active');
        } else {
          seccionHistorial.classList.remove('hidden');
          tabHistorial.classList.add('is-active');
        }
      }

      function abrirModalCrearHistoria(citaId, paciente) {
        document.getElementById('citaIdHistoria').value = citaId;
        document.getElementById('crearPacienteNombre').innerText = paciente || '-';
        document.getElementById('modalCrearHistoria').classList.remove('hidden');
      }
      function cerrarModalCrearHistoria() {
        document.getElementById('modalCrearHistoria').classList.add('hidden');
        document.getElementById('formCrearHistoria').reset();
      }

      function abrirModalReprogramar(citaId) {
        document.getElementById('citaIdReprogramar').value = citaId;
        document.getElementById('modalReprogramar').classList.remove('hidden');
      }
      function cerrarModalReprogramar() {
        document.getElementById('modalReprogramar').classList.add('hidden');
        document.getElementById('formReprogramar').reset();
      }

      async function guardarHistoria(event) {
        event.preventDefault();
        const formulario = document.getElementById('formCrearHistoria');
        const datosFormulario = Object.fromEntries(new FormData(formulario).entries());
        const citaId = datosFormulario.citaId;
        const csrf = datosFormulario._csrf;
        const motivo = (datosFormulario.motivoConsulta || '').trim();
        const codigoCie10 = (datosFormulario.codigoCie10 || '').trim().toUpperCase();
        const diagnosticoPrincipal = (datosFormulario.diagnosticoPrincipal || '').trim();
        delete datosFormulario.citaId;
        delete datosFormulario._csrf;
        delete datosFormulario.motivoConsulta;
        delete datosFormulario.codigoCie10;
        delete datosFormulario.diagnosticoPrincipal;

        if (!motivo || !codigoCie10 || !diagnosticoPrincipal || !(datosFormulario.planTratamiento || '').trim()) {
          mostrarNotificacion({ tipo: 'warning', titulo: 'Información incompleta', mensaje: 'Completa el motivo, el código CIE-10, el diagnóstico principal y el plan de manejo.' });
          return;
        }

        try {
          const respuesta = await fetch('/medico/historia-clinica', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
            body: JSON.stringify({ citaId, motivo, codigoCie10, diagnosticoPrincipal, datosClinicos: datosFormulario, _csrf: csrf })
          });
          const resultado = await respuesta.json();
          if (respuesta.ok) {
            mostrarNotificacion({ tipo: 'success', titulo: 'Historia clínica guardada', mensaje: resultado.mensaje || 'La atención quedó registrada correctamente.' });
            window.setTimeout(() => window.location.reload(), 900);
          } else {
            mostrarNotificacion({ tipo: 'error', titulo: 'No se pudo guardar', mensaje: resultado.error || 'No fue posible guardar la historia clínica.' });
          }
        } catch (error) {
          console.error('Error al guardar historia clínica:', error);
          mostrarNotificacion({ tipo: 'error', titulo: 'Error de conexión', mensaje: 'No fue posible guardar la historia clínica. Revisa tu conexión e inténtalo nuevamente.' });
        }
      }

      async function cancelarCita(citaId) {
        const confirmar = await confirmarEnAplicacion({
          titulo: 'Cancelar cita',
          mensaje: '¿Estás seguro de que deseas cancelar esta cita? Esta acción no se puede deshacer.',
          textoConfirmar: 'Sí, cancelar cita',
          peligro: true
        });
        if (!confirmar) return;
        const csrf = document.getElementById('csrfToken').value;

        try {
            const respuesta = await fetch(`/citas/${citaId}/cancelar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
                body: JSON.stringify({ _csrf: csrf })
            });
            if(respuesta.ok) {
                mostrarNotificacion({ tipo: 'success', titulo: 'Cita cancelada', mensaje: 'La cita se canceló correctamente.' });
                window.setTimeout(() => window.location.reload(), 900);
            } else {
                mostrarNotificacion({ tipo: 'error', titulo: 'No se pudo cancelar', mensaje: 'Ocurrió un problema al cancelar la cita.' });
            }
        } catch (error) {
            console.error('Error al cancelar la cita:', error);
            mostrarNotificacion({ tipo: 'error', titulo: 'Error de conexión', mensaje: 'No fue posible comunicarse con el servidor. Inténtalo nuevamente.' });
        }
      }

      async function guardarReprogramacion(event) {
        event.preventDefault();
        const citaId = document.getElementById('citaIdReprogramar').value;
        const nuevaFecha = document.getElementById('nuevaFecha').value;
        const nuevaHora = document.getElementById('nuevaHora').value;
        const csrf = document.getElementById('csrfToken').value;

        try {
            const respuesta = await fetch(`/citas/${citaId}/reprogramar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
                body: JSON.stringify({ nuevaFecha, nuevaHora, _csrf: csrf })
            });
            const resultado = await respuesta.json();
            if(respuesta.ok) {
                mostrarNotificacion({ tipo: 'success', titulo: 'Cita reprogramada', mensaje: 'La fecha y la hora de la cita se actualizaron correctamente.' });
                window.setTimeout(() => window.location.reload(), 900); 
            } else {
                mostrarNotificacion({ tipo: 'error', titulo: 'No se pudo reprogramar', mensaje: resultado.error || 'Ocurrió un problema al reprogramar la cita.' });
            }
        } catch (error) {
            console.error("Error:", error);
            mostrarNotificacion({ tipo: 'error', titulo: 'Error de conexión', mensaje: 'No fue posible comunicarse con el servidor. Inténtalo nuevamente.' });
        }
      }
    script(src="/js/notificaciones.js")