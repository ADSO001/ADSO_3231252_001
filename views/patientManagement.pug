doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title SIGCMI - Pacientes
    script(src="https://cdn.tailwindcss.com")
    //- Lucide Icons (CDN)
    script(src="https://unpkg.com/lucide@latest")
    style.
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

  body(class="m-0 p-0 box-border bg-white text-gray-800")
    div(class="flex flex-col md:flex-row min-h-screen")
      
      //- BARRA LATERAL (SIDEBAR)
      aside(class="w-full md:w-[260px] bg-white border-r border-gray-200 flex flex-col shrink-0 md:sticky md:top-0 md:h-screen md:overflow-y-auto")
        div(class="p-[20px] flex items-center gap-[10px] border-b border-gray-200")
          div(class="w-[60px] h-[60px] max-w-[60px] max-h-[60px]")
            img(src="img/logo.png", alt="logo", class="w-full h-full object-contain")
          h1(class="text-[20px] font-bold") SIGCMI

        nav(class="flex-1 p-[20px_10px] flex flex-col gap-[8px]")
          a(href="/adminPanel", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="layout-dashboard", class="w-[20px] h-[20px]")
            | Panel principal

          a(href="/appointmentScheduleAdmin", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="calendar", class="w-[20px] h-[20px]")
            | Agenda de citas

          a(href="/patientManagement", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#000000] rounded-[10px] text-[14px] font-bold bg-[#e0e0e0] no-underline")
            i(data-lucide="users", class="w-[20px] h-[20px]")
            | Pacientes

          a(href="#", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="stethoscope", class="w-[20px] h-[20px]")
            | Médicos

          a(href="/managementSpecialities", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="user-check", class="w-[20px] h-[20px]")
            | Verificar Médicos

          a(href="/doctorsHours", class="flex items-center gap-[10px] px-[15px] py-[8px] text-[#555555] rounded-[10px] text-[14px] font-bold bg-[#f5f5f5] hover:bg-[#e8e8e8] no-underline transition-colors")
            i(data-lucide="clock", class="w-[20px] h-[20px]")
            | Horarios

        div(class="p-[20px] border-t border-gray-200 flex flex-col gap-[15px]")
          div(class="flex items-center gap-[10px]")
            div(class="w-[35px] h-[35px] rounded-full bg-black text-white flex items-center justify-center")
              i(data-lucide="user", class="w-[20px] h-[20px]")
            div(class="flex flex-col")
              span(class="text-[14px] font-bold text-gray-900") Admin
              span(class="text-[12px] text-gray-500") Administrador

          a(href="/login", class="no-underline")
            button(type="button", class="bg-black text-white px-[15px] py-[10px] rounded-[20px] flex items-center justify-center gap-[10px] font-bold text-[14px] w-fit cursor-pointer hover:opacity-80 transition-opacity border-none")
              i(data-lucide="log-out", class="w-[18px] h-[18px]")
              | Cerrar sesión

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 p-[30px] bg-[#fafafa]")
        
        //- ENCABEZADO Y BUSCADOR
        header(class="mb-[30px]")
          h2(class="text-[24px] font-bold mb-[5px] text-gray-900") Pacientes
          p(class="text-[14px] text-gray-500 m-0 mb-[25px]") Gestiona la información de todos los pacientes
          
          div(class="relative max-w-[800px]")
            i(data-lucide="search", class="absolute left-[18px] top-1/2 -translate-y-1/2 w-[16px] h-[16px] text-gray-400")
            input(type="text", class="w-full py-[12px] pr-[15px] pl-[45px] border border-gray-200 bg-white rounded-[10px] text-[14px] outline-none focus:border-gray-400 transition-colors", placeholder="Buscar por nombre, email o teléfono...")

        //- LISTA DE TARJETAS DE PACIENTES
        div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-[20px]")

          //- Tarjeta 1: Juan Pérez García
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm flex flex-col justify-between")
            div
              div(class="absolute top-[20px] right-[20px] bg-[#f5f5f5] text-gray-600 w-[24px] h-[24px] rounded-full flex items-center justify-center text-[11px] font-bold") M
              div(class="flex items-center gap-[12px] mb-[15px]")
                div(class="w-[45px] h-[45px] bg-[#e0e0e0] rounded-full flex items-center justify-center font-bold text-gray-800 text-[14px]") JP
                div
                  h3(class="text-[15px] font-bold text-gray-900 m-0") Juan Pérez García
                  span(class="text-[12px] text-gray-400 font-medium") 40 años
              
              div(class="text-[13px] text-gray-600 flex flex-col gap-[6px] mb-[20px]")
                p(class="m-0") Email: juan.perez@email.com
                p(class="m-0") Teléfono: +57 300 555 0101
                p(class="m-0 flex items-center gap-[5px]")
                  | Tipo de sangre: 
                  span(class="bg-black text-white px-[6px] py-[1px] rounded-[4px] text-[11px] font-bold") O+
                p(class="m-0") Alergias: Penicilina
            
            button(type="button", class="w-full py-[8px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm flex items-center justify-center gap-[6px]")
              i(data-lucide="folder", class="w-[14px] h-[14px]")
              | Historial

          //- Tarjeta 2: Ana López Ruiz
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm flex flex-col justify-between")
            div
              div(class="absolute top-[20px] right-[20px] bg-[#f5f5f5] text-gray-600 w-[24px] h-[24px] rounded-full flex items-center justify-center text-[11px] font-bold") F
              div(class="flex items-center gap-[12px] mb-[15px]")
                div(class="w-[45px] h-[45px] bg-[#e0e0e0] rounded-full flex items-center justify-center font-bold text-gray-800 text-[14px]") AL
                div
                  h3(class="text-[15px] font-bold text-gray-900 m-0") Ana López Ruiz
                  span(class="text-[12px] text-gray-400 font-medium") 35 años
              
              div(class="text-[13px] text-gray-600 flex flex-col gap-[6px] mb-[20px]")
                p(class="m-0") Email: ana.lopez@email.com
                p(class="m-0") Teléfono: +57 300 555 0101
                p(class="m-0 flex items-center gap-[5px]")
                  | Tipo de sangre: 
                  span(class="bg-black text-white px-[6px] py-[1px] rounded-[4px] text-[11px] font-bold") A+
                p(class="m-0") Alergias: Ninguna conocida
            
            button(type="button", class="w-full py-[8px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm flex items-center justify-center gap-[6px]")
              i(data-lucide="folder", class="w-[14px] h-[14px]")
              | Historial

          //- Tarjeta 3: Pedro Ramírez Torres
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm flex flex-col justify-between")
            div
              div(class="absolute top-[20px] right-[20px] bg-[#f5f5f5] text-gray-600 w-[24px] h-[24px] rounded-full flex items-center justify-center text-[11px] font-bold") M
              div(class="flex items-center gap-[12px] mb-[15px]")
                div(class="w-[45px] h-[45px] bg-[#e0e0e0] rounded-full flex items-center justify-center font-bold text-gray-800 text-[14px]") PR
                div
                  h3(class="text-[15px] font-bold text-gray-900 m-0") Pedro Ramírez Torres
                  span(class="text-[12px] text-gray-400 font-medium") 10 años
              
              div(class="text-[13px] text-gray-600 flex flex-col gap-[6px] mb-[20px]")
                p(class="m-0") Email: ramirez.familia@email.com
                p(class="m-0") Teléfono: +57 300 555 0101
                p(class="m-0 flex items-center gap-[5px]")
                  | Tipo de sangre: 
                  span(class="bg-black text-white px-[6px] py-[1px] rounded-[4px] text-[11px] font-bold") B+
                p(class="m-0") Alergias: Ninguna conocida
            
            button(type="button", class="w-full py-[8px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm flex items-center justify-center gap-[6px]")
              i(data-lucide="folder", class="w-[14px] h-[14px]")
              | Historial

          //- Tarjeta 4: Sofía Martínez Díaz
          div(class="bg-white border border-gray-200 rounded-[12px] p-[20px] relative shadow-sm flex flex-col justify-between")
            div
              div(class="absolute top-[20px] right-[20px] bg-[#f5f5f5] text-gray-600 w-[24px] h-[24px] rounded-full flex items-center justify-center text-[11px] font-bold") F
              div(class="flex items-center gap-[12px] mb-[15px]")
                div(class="w-[45px] h-[45px] bg-[#e0e0e0] rounded-full flex items-center justify-center font-bold text-gray-800 text-[14px]") SM
                div
                  h3(class="text-[15px] font-bold text-gray-900 m-0") Sofía Martínez Díaz
                  span(class="text-[12px] text-gray-400 font-medium") 47 años
              
              div(class="text-[13px] text-gray-600 flex flex-col gap-[6px] mb-[20px]")
                p(class="m-0") Email: sofia.martinez@email.com
                p(class="m-0") Teléfono: +57 300 555 0101
                p(class="m-0 flex items-center gap-[5px]")
                  | Tipo de sangre: 
                  span(class="bg-black text-white px-[6px] py-[1px] rounded-[4px] text-[11px] font-bold") AB+
                p(class="m-0") Alergias: Látex, Polen
            
            button(type="button", class="w-full py-[8px] border border-gray-300 rounded-[8px] bg-white text-[12px] font-bold text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer shadow-sm flex items-center justify-center gap-[6px]")
              i(data-lucide="folder", class="w-[14px] h-[14px]")
              | Historial

    //- Script para inicializar los íconos de Lucide
    script.
      lucide.createIcons();