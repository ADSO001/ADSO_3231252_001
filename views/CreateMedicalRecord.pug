extends layout/index

block contenido
  .container.mt-4
    h2.mb-4 Crear Historia Clínica
    
    if error
      .alert.alert-danger= error

    .card.mb-4
      .card-body
        h5.card-title Datos de la Consulta
        p
          strong Cita ID: 
          span= appointment ? appointment.appointment_id : ''
        p
          strong Paciente: 
          span= appointment ? appointment.patient_name : ''

    form(action="/medical-record/create", method="POST")
      input(type="hidden", name="appointment_id", value=appointment ? appointment.appointment_id : '')
      input(type="hidden", name="patient_id", value=appointment ? appointment.patient_id : '')

      .mb-3
        label.form-label(for="consultation_reason") Motivo de Consulta (*)
        textarea#consultation_reason.form-control(name="consultation_reason", rows="3", required=true)

      .mb-3
        label.form-label(for="symptoms_anamnesis") Anamnesis / Síntomas
        textarea#symptoms_anamnesis.form-control(name="symptoms_anamnesis", rows="3")

      .row.g-3.mb-3
        .col-md-4
          label.form-label(for="diagnosis_code") Código Diagnóstico (CIE-10) (*)
          input#diagnosis_code.form-control(type="text", name="diagnosis_code", placeholder="Ej. K35.8", required=true)
        .col-md-8
          label.form-label(for="diagnosis_description") Descripción del Diagnóstico
          input#diagnosis_description.form-control(type="text", name="diagnosis_description", placeholder="Ej. Apendicitis aguda")

      .mb-4
        label.form-label(for="treatment_plan") Plan de Tratamiento
        textarea#treatment_plan.form-control(name="treatment_plan", rows="3")

      h4.mt-4 Prescripción de Medicamentos
      #medications-container
        .row.g-2.mb-2.medication-row
          .col-md-3
            input.form-control(type="text", name="medication_name", placeholder="Medicamento")
          .col-md-2
            input.form-control(type="text", name="dosage", placeholder="Dosis")
          .col-md-2
            input.form-control(type="text", name="frequency", placeholder="Frecuencia")
          .col-md-2
            input.form-control(type="text", name="duration", placeholder="Duración")
          .col-md-3
            input.form-control(type="text", name="instructions", placeholder="Indicaciones")

      button#add-med-btn.btn.btn-secondary.btn-sm.mt-2.mb-4(type="button") + Agregar Otro Medicamento

      .d-flex.justify-content-end.gap-2
        a.btn.btn-outline-secondary(href="/medical/panel") Cancelar
        button.btn.btn-primary(type="submit") Guardar y Finalizar Consulta

    script.
      document.getElementById('add-med-btn').addEventListener('click', function() {
        const container = document.getElementById('medications-container');
        const firstRow = container.querySelector('.medication-row');
        const newRow = firstRow.cloneNode(true);
        newRow.querySelectorAll('input').forEach(input => input.value = '');
        container.appendChild(newRow);
      });