extends layout/index

block contenido
  .container.mx-auto.px-4.py-8
    h1.text-3xl.font-bold.text-gray-800.mb-6 Dashboard del Administrador

    // Métricas Generales
    if metricas
      .grid.grid-cols-1.sm:grid-cols-2.md:grid-cols-4.gap-6.mb-8
        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-blue-500
          p.text-sm.text-gray-500.font-medium Total Citas
          p.text-2xl.font-bold.text-gray-800= metricas.totalCitas

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-indigo-500
          p.text-sm.text-gray-500.font-medium Citas Hoy
          p.text-2xl.font-bold.text-gray-800= metricas.citasHoy

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-yellow-500
          p.text-sm.text-gray-500.font-medium Pendientes
          p.text-2xl.font-bold.text-gray-800= metricas.citasPendientes

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-green-500
          p.text-sm.text-gray-500.font-medium Confirmadas
          p.text-2xl.font-bold.text-gray-800= metricas.citasConfirmadas

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-teal-500
          p.text-sm.text-gray-500.font-medium Completadas
          p.text-2xl.font-bold.text-gray-800= metricas.citasCompletadas

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-red-500
          p.text-sm.text-gray-500.font-medium Canceladas
          p.text-2xl.font-bold.text-gray-800= metricas.citasCanceladas

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-purple-500
          p.text-sm.text-gray-500.font-medium Total Usuarios
          p.text-2xl.font-bold.text-gray-800= metricas.totalUsuarios

        .bg-white.shadow-md.rounded-lg.p-5.border-l-4.border-pink-500
          p.text-sm.text-gray-500.font-medium Pacientes Totales
          p.text-2xl.font-bold.text-gray-800= metricas.totalClientes

    // Citas del Día
    .bg-white.shadow-md.rounded-lg.overflow-hidden.p-6
      h2.text-xl.font-semibold.text-gray-800.mb-4 Citas Programadas para Hoy

      if citasDelDia && citasDelDia.length
        .overflow-x-auto
          table.min-w-full.divide-y.divide-gray-200
            thead.bg-gray-50
              tr
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Hora
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Paciente
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Médico
                th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Estado
                th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.uppercase Acciones
            tbody.bg-white.divide-y.divide-gray-200
              each cita in citasDelDia
                tr
                  td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900= cita.hora
                  td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900= cita.paciente ? `${cita.paciente.nombre} ${cita.paciente.apellido}` : 'No asignado'
                  td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500= cita.medico ? `${cita.medico.nombre} ${cita.medico.apellido}` : 'Sin asignar'
                  td.px-6.py-4.whitespace-nowrap.text-sm
                    case cita.estado
                      when 'pendiente'
                        span.px-2.inline-flex.text-xs.leading-5.font-semibold.rounded-full.bg-yellow-100.text-yellow-800 Pendiente
                      when 'confirmada'
                        span.px-2.inline-flex.text-xs.leading-5.font-semibold.rounded-full.bg-green-100.text-green-800 Confirmada
                      when 'completada'
                        span.px-2.inline-flex.text-xs.leading-5.font-semibold.rounded-full.bg-blue-100.text-blue-800 Completada
                      when 'cancelada'
                        span.px-2.inline-flex.text-xs.leading-5.font-semibold.rounded-full.bg-red-100.text-red-800 Cancelada
                      default
                        span.px-2.inline-flex.text-xs.leading-5.font-semibold.rounded-full.bg-gray-100.text-gray-800= cita.estado
                  td.px-6.py-4.whitespace-nowrap.text-center.text-sm.font-medium
                    a.text-indigo-600.hover:text-indigo-900(href=`/appointmentScheduleAdmin?id=${cita.id}`) Detalle
      else
        .text-center.py-8
          p.text-gray-500.text-lg No hay citas programadas para el día de hoy.